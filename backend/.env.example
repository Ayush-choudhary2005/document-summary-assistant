# Server
PORT=5000
NODE_ENV=development

# Comma-separated list of origins allowed to call this API
CORS_ORIGIN=http://localhost:5173

# Max upload size in megabytes
MAX_FILE_SIZE_MB=15

# --- Optional: AI-Enhanced Mode -------------------------------------------
# The app works fully offline with the built-in extractive summarizer.
# If you set an Anthropic API key below, users can toggle "AI Enhanced Mode"
# in the UI to get an abstractive (rewritten, more natural) summary instead
# of the default extractive one. Leave blank to disable this feature.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
